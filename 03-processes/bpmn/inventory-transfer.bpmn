<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_inventory_transfer" targetNamespace="https://buildflow.example/portfolio" exporter="BuildFlow portfolio" exporterVersion="1.0">
  <bpmn:error id="ERP_Error" name="ERP delivery failure" errorCode="ERP_UNCERTAIN" />
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="BuildFlow" name="Material transfer" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" name="Material transfer" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_0" name="Sending site">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dispatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>chase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timerEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Operational service">
        <bpmn:flowNodeRef>transit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Receiving site">
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>held</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Transfer requested">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="dispatch" name="Confirm destination and dispatch">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="transit" name="In Transit; retain sender custody">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="wait" name="Destination receives and inspects">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="receipt" name="Right site and good condition?" default="Flow_5">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="assign" name="Atomic destination Assigned + history">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="Destination custody confirmed">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="hold" name="Reject/quarantine; record exception">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="held" name="Receipt unresolved / Damaged">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="timer" name="24h receipt overdue" attachedToRef="wait" cancelActivity="false">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="chase" name="Chase source and receiver; no auto receipt">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="timerEnd" name="Escalation sent">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="start" targetRef="dispatch" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="dispatch" targetRef="transit" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="transit" targetRef="wait" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="wait" targetRef="receipt" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="receipt" targetRef="assign" name="valid receipt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">valid_receipt</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="receipt" targetRef="hold" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="assign" targetRef="end" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="hold" targetRef="held" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="timer" targetRef="chase" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="chase" targetRef="timerEnd" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="PoolDI" bpmnElement="BuildFlow" isHorizontal="true">
        <dc:Bounds x="30" y="30" width="1456" height="610" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneDI_0" bpmnElement="Lane_0" isHorizontal="true">
        <dc:Bounds x="60" y="55" width="1426" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneDI_1" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="60" y="235" width="1426" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneDI_2" bpmnElement="Lane_2" isHorizontal="true">
        <dc:Bounds x="60" y="415" width="1426" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_start" bpmnElement="start" isHorizontal="true">
        <dc:Bounds x="185" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_dispatch" bpmnElement="dispatch" isHorizontal="true">
        <dc:Bounds x="380" y="80" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_transit" bpmnElement="transit" isHorizontal="true">
        <dc:Bounds x="575" y="260" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_wait" bpmnElement="wait" isHorizontal="true">
        <dc:Bounds x="770" y="440" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_receipt" bpmnElement="receipt" isHorizontal="true">
        <dc:Bounds x="965" y="440" width="48" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_assign" bpmnElement="assign" isHorizontal="true">
        <dc:Bounds x="1160" y="260" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_end" bpmnElement="end" isHorizontal="true">
        <dc:Bounds x="1355" y="440" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_hold" bpmnElement="hold" isHorizontal="true">
        <dc:Bounds x="1160" y="440" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_held" bpmnElement="held" isHorizontal="true">
        <dc:Bounds x="1355" y="440" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_timer" bpmnElement="timer" isHorizontal="true">
        <dc:Bounds x="855" y="495" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_chase" bpmnElement="chase" isHorizontal="true">
        <dc:Bounds x="965" y="80" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_timerEnd" bpmnElement="timerEnd" isHorizontal="true">
        <dc:Bounds x="1160" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_0" bpmnElement="Flow_0">
        <di:waypoint x="221" y="98.0" />
        <di:waypoint x="380" y="115.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1">
        <di:waypoint x="535" y="115.0" />
        <di:waypoint x="575" y="295.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2">
        <di:waypoint x="730" y="295.0" />
        <di:waypoint x="770" y="475.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3">
        <di:waypoint x="925" y="475.0" />
        <di:waypoint x="965" y="464.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4">
        <di:waypoint x="1013" y="464.0" />
        <di:waypoint x="1160" y="295.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5">
        <di:waypoint x="1013" y="464.0" />
        <di:waypoint x="1160" y="475.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6">
        <di:waypoint x="1315" y="295.0" />
        <di:waypoint x="1355" y="458.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_7" bpmnElement="Flow_7">
        <di:waypoint x="1315" y="475.0" />
        <di:waypoint x="1355" y="458.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_8" bpmnElement="Flow_8">
        <di:waypoint x="891" y="513.0" />
        <di:waypoint x="965" y="115.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_9" bpmnElement="Flow_9">
        <di:waypoint x="1120" y="115.0" />
        <di:waypoint x="1160" y="98.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
