<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_inventory_damage" targetNamespace="https://buildflow.example/portfolio" exporter="BuildFlow portfolio" exporterVersion="1.0">
  <bpmn:error id="ERP_Error" name="ERP delivery failure" errorCode="ERP_UNCERTAIN" />
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="BuildFlow" name="Damaged material handling" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" name="Damaged material handling" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_0" name="Warehouse / Operations">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Operational service">
        <bpmn:flowNodeRef>claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Damage detected">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="record" name="Record damage and quarantine">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="claim" name="Damaged + linked claim draft">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="assess" name="Assess safe repair / disposal options">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gate" name="Repair feasible?" default="Flow_5">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="repair" name="Authorised repair / Maintenance">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="inspect" name="Safety inspection after repair">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="pass" name="Inspection passed?" default="Flow_9">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="release" name="Release Available + history">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="Safe circulation restored">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="retire" name="Authorise retirement; notify Finance">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="retired" name="Retired; ERP disposal separate">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="fail" name="Maintenance remains; rework required">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="start" targetRef="record" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="record" targetRef="claim" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="claim" targetRef="assess" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="assess" targetRef="gate" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="gate" targetRef="repair" name="repair feasible">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">repair_feasible</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="gate" targetRef="retire" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="repair" targetRef="inspect" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="inspect" targetRef="pass" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="pass" targetRef="release" name="passed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">passed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="pass" targetRef="fail" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="release" targetRef="end" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="retire" targetRef="retired" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="PoolDI" bpmnElement="BuildFlow" isHorizontal="true">
        <dc:Bounds x="30" y="30" width="2041" height="430" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneDI_0" bpmnElement="Lane_0" isHorizontal="true">
        <dc:Bounds x="60" y="55" width="2011" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneDI_1" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="60" y="235" width="2011" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_start" bpmnElement="start" isHorizontal="true">
        <dc:Bounds x="185" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_record" bpmnElement="record" isHorizontal="true">
        <dc:Bounds x="380" y="80" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_claim" bpmnElement="claim" isHorizontal="true">
        <dc:Bounds x="575" y="260" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_assess" bpmnElement="assess" isHorizontal="true">
        <dc:Bounds x="770" y="80" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_gate" bpmnElement="gate" isHorizontal="true">
        <dc:Bounds x="965" y="80" width="48" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_repair" bpmnElement="repair" isHorizontal="true">
        <dc:Bounds x="1160" y="80" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_inspect" bpmnElement="inspect" isHorizontal="true">
        <dc:Bounds x="1355" y="80" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_pass" bpmnElement="pass" isHorizontal="true">
        <dc:Bounds x="1550" y="80" width="48" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_release" bpmnElement="release" isHorizontal="true">
        <dc:Bounds x="1745" y="260" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_end" bpmnElement="end" isHorizontal="true">
        <dc:Bounds x="1940" y="260" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_retire" bpmnElement="retire" isHorizontal="true">
        <dc:Bounds x="1160" y="165" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_retired" bpmnElement="retired" isHorizontal="true">
        <dc:Bounds x="1355" y="165" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_fail" bpmnElement="fail" isHorizontal="true">
        <dc:Bounds x="1745" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_0" bpmnElement="Flow_0">
        <di:waypoint x="221" y="98.0" />
        <di:waypoint x="380" y="115.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1">
        <di:waypoint x="535" y="115.0" />
        <di:waypoint x="575" y="295.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2">
        <di:waypoint x="730" y="295.0" />
        <di:waypoint x="770" y="115.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3">
        <di:waypoint x="925" y="115.0" />
        <di:waypoint x="965" y="104.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4">
        <di:waypoint x="1013" y="104.0" />
        <di:waypoint x="1160" y="115.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5">
        <di:waypoint x="1013" y="104.0" />
        <di:waypoint x="1160" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6">
        <di:waypoint x="1315" y="115.0" />
        <di:waypoint x="1355" y="115.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_7" bpmnElement="Flow_7">
        <di:waypoint x="1510" y="115.0" />
        <di:waypoint x="1550" y="104.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_8" bpmnElement="Flow_8">
        <di:waypoint x="1598" y="104.0" />
        <di:waypoint x="1745" y="295.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_9" bpmnElement="Flow_9">
        <di:waypoint x="1598" y="104.0" />
        <di:waypoint x="1745" y="98.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_10" bpmnElement="Flow_10">
        <di:waypoint x="1900" y="295.0" />
        <di:waypoint x="1940" y="278.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_11" bpmnElement="Flow_11">
        <di:waypoint x="1315" y="200.0" />
        <di:waypoint x="1355" y="183.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
